# Copie este arquivo para ".env" (na mesma pasta) e preencha com os dados do SEU banco.

# Neo4j Desktop / Docker local:
NEO4J_URI=bolt://localhost:7687
# Neo4j Aura (nuvem) usa algo como:
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io

# (NEO4J_USERNAME também funciona)
NEO4J_USER=neo4j
NEO4J_PASSWORD=sua_senha_aqui

# Opcional: nome do banco (deixe vazio para usar o padrão "neo4j")
NEO4J_DATABASE=

PORT=3000
